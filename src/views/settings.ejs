<%- include('includes/header', { currentPage: 'settings' }) %>

<div class="page-header">
  <h1 class="page-title">Settings</h1>
  <div class="page-breadcrumb">
    <span>Dashboard</span>
    <span class="page-breadcrumb-separator">/</span>
    <span>Settings</span>
  </div>
</div>

<% if (!member) { %>
  <div class="admin-card">
    <div class="text-center" style="padding: 60px 20px;">
      <h2 style="font-size: 24px; margin-bottom: 16px; color: var(--text-primary);">Access Denied</h2>
      <p style="color: var(--text-secondary); margin-bottom: 32px;">Please login first!</p>
      <a href="/admin/login" class="btn btn-primary">Login</a>
    </div>
  </div>
<% } else { %>
  <div class="admin-card">
    <div class="card-header">
      <div class="card-title">Account Settings</div>
    </div>
    <div class="form-content" style="padding-bottom: var(--spacing-xl);">
      <div class="form-group">
        <label class="form-label">Shop Name</label>
        <input type="text" class="form-input" value="<%= member.memberNick || '' %>" disabled />
        <div class="form-helper">Your jewellery shop name</div>
      </div>
      <div class="form-group" style="margin-bottom: 0;">
        <label class="form-label">Phone Number</label>
        <input type="text" class="form-input" value="<%= member.memberPhone || '' %>" disabled />
        <div class="form-helper">Contact phone number</div>
      </div>
    </div>
  </div>

  <div class="admin-card">
    <div class="card-header">
      <div class="card-title">Preferences</div>
    </div>
    <div style="padding: var(--spacing-xl); text-align: center; color: var(--text-secondary);">
      <p>Settings options will be available here</p>
    </div>
  </div>

  <div class="admin-card">
    <div class="card-header">
      <div class="card-title">System Information</div>
    </div>
    <div style="padding: var(--spacing-xl);">
      <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--spacing-lg);">
        <div>
          <div style="font-size: 12px; font-weight: 600; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 8px;">Version</div>
          <div style="font-size: 14px; color: var(--text-primary);">1.0.0</div>
        </div>
        <div>
          <div style="font-size: 12px; font-weight: 600; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 8px;">Status</div>
          <div style="font-size: 14px; color: var(--text-primary);">Active</div>
        </div>
      </div>
    </div>
  </div>
<% } %>

<%- include('includes/footer') %>


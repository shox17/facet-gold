<%- include('includes/header', { currentPage: 'messages' }) %>

<div class="page-header">
  <h1 class="page-title">Messages</h1>
  <div class="page-breadcrumb">
    <span>Dashboard</span>
    <span class="page-breadcrumb-separator">/</span>
    <span>Messages</span>
  </div>
</div>

<% if (!member) { %>
  <div class="admin-card">
    <div class="text-center" style="padding: 60px 20px;">
      <h2 style="font-size: 24px; margin-bottom: 16px; color: var(--text-primary);">Access Denied</h2>
      <p style="color: var(--text-secondary); margin-bottom: 32px;">Please login first!</p>
      <a href="/admin/login" class="btn btn-primary">Login</a>
    </div>
  </div>
<% } else { %>
  <div class="admin-card">
    <div class="card-header">
      <div class="card-title">Inbox</div>
      <div class="card-actions">
        <button class="btn btn-primary btn-sm">Mark All as Read</button>
      </div>
    </div>
    <div style="padding: var(--spacing-xl); text-align: center; color: var(--text-secondary);">
      <p>No messages yet</p>
      <p style="margin-top: 8px; font-size: 14px;">Customer messages will appear here</p>
    </div>
  </div>

  <div class="admin-card">
    <div class="card-header">
      <div class="card-title">Recent Conversations</div>
    </div>
    <div style="padding: var(--spacing-xl); text-align: center; color: var(--text-secondary);">
      <p>Message history will be displayed here</p>
    </div>
  </div>
<% } %>

<%- include('includes/footer') %>


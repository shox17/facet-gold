<%- include('includes/header', { currentPage: '' }) %>

<% if (!member) { %>
  <div class="admin-landing">
    <div class="landing-hero">
      <div class="landing-hero-content">
        <div class="landing-brand-section">
          <h1 class="landing-title">
            Facet & <span class="gold-accent">Gold</span> Admin
          </h1>
          <p class="landing-subtitle">Secure access to your jewellery catalogue, customers, and operations.</p>
          <p class="landing-helper">Please sign in to continue.</p>
        </div>
        <div class="landing-panel-wrapper">
          <div class="landing-panel">
            <div class="landing-panel-header">
              <h2 class="landing-panel-title">Admin Access</h2>
            </div>
            <div class="landing-panel-actions">
              <a href="/admin/login" class="btn btn-primary btn-lg">Login</a>
              <a href="/admin/signup" class="btn btn-secondary btn-lg">Sign Up</a>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="landing-features">
      <div class="feature-card">
        <div class="feature-icon">
          <svg width="24" height="24" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M10 2.5L4.16667 6.25L10 10L15.8333 6.25L10 2.5Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M4.16667 6.25L4.16667 13.75L10 17.5L15.8333 13.75V6.25" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M10 10V17.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <div class="feature-text">
          <div class="feature-title">Manage Products</div>
          <div class="feature-description">Update inventory, prices, and collections.</div>
        </div>
      </div>
      <div class="feature-card">
        <div class="feature-icon">
          <svg width="24" height="24" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M10 10C12.3012 10 14.1667 8.13452 14.1667 5.83333C14.1667 3.53215 12.3012 1.66667 10 1.66667C7.69881 1.66667 5.83333 3.53215 5.83333 5.83333C5.83333 8.13452 7.69881 10 10 10Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M17.1583 18.3333C17.1583 15.1083 13.95 12.5 10 12.5C6.05 12.5 2.84166 15.1083 2.84166 18.3333" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <div class="feature-text">
          <div class="feature-title">Customer Accounts</div>
          <div class="feature-description">View and manage customer profiles.</div>
        </div>
      </div>
      <div class="feature-card">
        <div class="feature-icon">
          <svg width="24" height="24" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M10 2.5V17.5M17.5 10H2.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
            <path d="M15.8333 6.66667C16.7538 7.58714 17.3147 8.80714 17.3147 10.0833C17.3147 11.3595 16.7538 12.5795 15.8333 13.5M4.16667 6.66667C3.24619 7.58714 2.68526 8.80714 2.68526 10.0833C2.68526 11.3595 3.24619 12.5795 4.16667 13.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <div class="feature-text">
          <div class="feature-title">Order Status</div>
          <div class="feature-description">Track and fulfill customer orders.</div>
        </div>
      </div>
      <div class="feature-card">
        <div class="feature-icon">
          <svg width="24" height="24" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M10 2.5V17.5M17.5 10H2.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
            <path d="M15.8333 6.66667C16.7538 7.58714 17.3147 8.80714 17.3147 10.0833C17.3147 11.3595 16.7538 12.5795 15.8333 13.5M4.16667 6.66667C3.24619 7.58714 2.68526 8.80714 2.68526 10.0833C2.68526 11.3595 3.24619 12.5795 4.16667 13.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <div class="feature-text">
          <div class="feature-title">Analytics</div>
          <div class="feature-description">Monitor sales and performance.</div>
        </div>
      </div>
    </div>
  </div>
<% } else { %>
  <div class="page-header">
    <h1 class="page-title">Dashboard</h1>
    <div class="page-breadcrumb">
      <span>Dashboard</span>
    </div>
  </div>
  <div class="stats-grid">
    <div class="stat-card">
      <div class="stat-card-header">
        <div class="stat-card-title">Total Customers</div>
      </div>
      <div class="stat-card-value">15</div>
      <div class="stat-card-change">View all customers</div>
    </div>
    <div class="stat-card">
      <div class="stat-card-header">
        <div class="stat-card-title">Total Products</div>
      </div>
      <div class="stat-card-value">10</div>
      <div class="stat-card-change">View all products</div>
    </div>
    <div class="stat-card">
      <div class="stat-card-header">
        <div class="stat-card-title">Active Orders</div>
      </div>
      <div class="stat-card-value">34</div>
      <div class="stat-card-change">Manage orders</div>
    </div>
  </div>

  <div class="admin-card">
    <div class="card-header">
      <div class="card-title">Quick Actions</div>
    </div>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px;">
      <a href="/admin/product/all" class="btn btn-primary" style="width: 100%;">
        Manage Products
      </a>
      <a href="/admin/user/all" class="btn btn-secondary" style="width: 100%;">
        Manage Customers
      </a>
    </div>
  </div>
<% } %>

<%- include('includes/footer') %>

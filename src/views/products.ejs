<%- include('includes/header', { currentPage: 'products' }) %>

<div class="page-header">
  <h1 class="page-title">Products</h1>
  <div class="page-breadcrumb">
    <span>Dashboard</span>
    <span class="page-breadcrumb-separator">/</span>
    <span>Products</span>
  </div>
</div>

<div class="admin-card">
  <div class="card-header">
    <div class="card-title">Jewellery Shop Products</div>
    <div class="card-actions">
      <button class="btn btn-primary" id="process-btn">
        + New Product
      </button>
    </div>
  </div>

  <div class="admin-table-container">
    <table class="admin-table">
      <thead>
        <tr>
          <th>#</th>
          <th>Product Name</th>
          <th>Product Collection</th>
          <th>Product Size</th>
          <th>Product Weight</th>
          <th>Product Price</th>
          <th>Product Stock</th>
          <th>Product Status</th>
        </tr>
      </thead>
      <tbody>
        <% products.map(function(value, key) { %>
        <tr>
          <td><%= key + 1 %></td>
          <td><%= value.productName %></td>
          <td><%= value.productCollection %></td>
          <td><%= value.productSize || 'N/A' %></td>
          <td><%= value.productVolume ? value.productVolume + 'g' : 'N/A' %></td>
          <td>$<%= value.productPrice %></td>
          <td><%= value.productLeftCount %></td>
          <td>
            <select class="spec-select new-product-status" id="<%= value._id %>" style="min-width: 120px; padding: 8px 12px; border: 1px solid var(--border-color); border-radius: var(--radius); background-color: var(--card-bg);">
              <option value="PAUSE" <%=value.productStatus==='PAUSE' ? 'selected' : '' %>>PAUSE</option>
              <option value="PROCESS" <%=value.productStatus==='PROCESS' ? 'selected' : '' %>>PROCESS</option>
              <option value="DELETE" <%=value.productStatus==='DELETE' ? 'selected' : '' %>>DELETE</option>
            </select>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<form onsubmit="return validateForm()" action="/admin/product/create" method="POST" class="admin-card product-form-container" style="display: none;" enctype="multipart/form-data">
  <div class="card-header">
    <div class="card-title">New Product Detail</div>
  </div>

  <div class="form-content">
    <!-- Product Name - Full Width -->
    <div class="form-group">
      <label class="form-label required">Product Name</label>
      <input type="text" name="productName" class="form-input product-name" placeholder="Enter product name" required />
    </div>

    <input name="productStatus" value="PAUSE" class="product-status" hidden />

    <!-- Price and Stock - 2 Column Grid -->
    <div class="form-row">
      <div class="form-group">
        <label class="form-label required">Product Price</label>
        <input type="text" name="productPrice" class="form-input product-price" placeholder="0.00" inputmode="decimal" pattern="[0-9]*\.?[0-9]*" required />
        <div class="form-helper">Enter price in dollars</div>
      </div>
      <div class="form-group">
        <label class="form-label required">Product Stock</label>
        <input type="text" name="productLeftCount" class="form-input product-left-count" placeholder="0" inputmode="numeric" pattern="[0-9]*" required />
        <div class="form-helper">Available quantity</div>
      </div>
    </div>

    <!-- Collection and Ring Size - 2 Column Grid -->
    <div class="form-row">
      <div class="form-group">
        <label class="form-label required">Product Collection</label>
        <select class="form-select product-collection" name="productCollection" required>
          <option value="RING">Ring</option>
          <option value="NECKLACE">Necklace</option>
          <option value="BRACELET">Bracelet</option>
          <option value="EARRING">Earring</option>
          <option value="OTHER">Other</option>
        </select>
        <div class="form-helper">Select jewellery type</div>
      </div>
      <div class="form-group">
        <label class="form-label required">Product Size</label>
        <select class="form-select product-size" name="productSize" required>
          <option value="US_4">US 4</option>
          <option value="US_4.5">US 4.5</option>
          <option value="US_5">US 5</option>
          <option value="US_5.5">US 5.5</option>
          <option value="US_6" selected>US 6</option>
          <option value="US_6.5">US 6.5</option>
          <option value="US_7">US 7</option>
          <option value="US_7.5">US 7.5</option>
          <option value="US_8">US 8</option>
          <option value="US_8.5">US 8.5</option>
          <option value="US_9">US 9</option>
          <option value="US_9.5">US 9.5</option>
          <option value="US_10">US 10</option>
        </select>
        <div class="form-helper">Sizes vary by jewellery type (e.g., US ring sizes, bracelet lengths)</div>
      </div>
    </div>

    <!-- Metal Weight - Full Width -->
    <div class="form-group">
      <label class="form-label required">Metal Weight (Grams)</label>
      <select class="form-select product-volume" name="productVolume" required>
        <option value="1">1g</option>
        <option value="2">2g</option>
        <option value="3">3g</option>
        <option value="4">4g</option>
        <option value="5" selected>5g</option>
        <option value="6">6g</option>
        <option value="8">8g</option>
        <option value="10">10g</option>
        <option value="12">12g</option>
        <option value="15">15g</option>
        <option value="20">20g</option>
        <option value="30">30g</option>
        <option value="50">50g</option>
      </select>
      <div class="form-helper">Metal weight in grams (e.g., 4.8)</div>
    </div>

    <!-- Description - Full Width -->
    <div class="form-group">
      <label class="form-label">Product Description</label>
      <textarea name="productDesc" class="form-textarea product-desc" placeholder="Enter product description" rows="4"></textarea>
    </div>

    <!-- Product Images -->
    <div class="form-group">
      <label class="form-label required">Product Images</label>
      <div class="upload-preview" id="image-previews" style="display: grid; grid-template-columns: repeat(5, 1fr); gap: 16px;">
      <div class="upload-img-box">
        <img src="/img/upload.svg" class="1" id="image-section-1" />
        <input type="file" id="file-1" name="productImages" class="image-one" required accept="image/*" onchange="previewFileHandler(this, 1)" style="display: none;" />
      </div>
      <div class="upload-img-box">
        <img src="/img/upload.svg" class="2" id="image-section-2" />
        <input type="file" id="file-2" name="productImages" class="image-two" accept="image/*" onchange="previewFileHandler(this, 2)" style="display: none;" />
      </div>
      <div class="upload-img-box">
        <img src="/img/upload.svg" class="3" id="image-section-3" />
        <input type="file" id="file-3" name="productImages" class="image-three" accept="image/*" onchange="previewFileHandler(this, 3)" style="display: none;" />
      </div>
      <div class="upload-img-box">
        <img src="/img/upload.svg" class="4" id="image-section-4" />
        <input type="file" id="file-4" name="productImages" class="image-four" accept="image/*" onchange="previewFileHandler(this, 4)" style="display: none;" />
      </div>
      <div class="upload-img-box">
        <img src="/img/upload.svg" class="5" id="image-section-5" />
        <input type="file" id="file-5" name="productImages" class="image-five" accept="image/*" onchange="previewFileHandler(this, 5)" style="display: none;" />
      </div>
      <input name="restaurantIid" class="restaurant-id" hidden />
    </div>
  </div>

  <div class="form-actions">
    <button type="button" class="btn btn-secondary" id="cancel-btn">Cancel</button>
    <button type="submit" class="btn btn-primary" id="create-btn">Create Product</button>
  </div>
</form>

<script>
  // Make images clickable to trigger file input
  document.querySelectorAll('.upload-img-box').forEach((box, index) => {
    box.addEventListener('click', () => {
      const inputId = 'file-' + (index + 1);
      const input = document.getElementById(inputId);
      if (input) input.click();
    });
  });
</script>

<script type="text/javascript" src="/js/products.js"></script>
<%- include('includes/footer') %>

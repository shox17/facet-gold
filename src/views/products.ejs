<%- include('includes/header', { currentPage: 'products' }) %>

<div class="page-header-enhanced">
  <div class="page-header-content">
    <div class="page-header-text">
      <h1 class="page-title">Products</h1>
      <p class="page-subtitle">Manage your catalogue</p>
    </div>
  </div>
  <div class="page-breadcrumb">
    <span>Dashboard</span>
    <span class="page-breadcrumb-separator">/</span>
    <span>Products</span>
  </div>
</div>

<!-- Summary Stats -->
<div class="products-stats-grid">
  <div class="product-stat-card">
    <div class="stat-card__icon stat-card__icon--products">
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M10 2.5L4.16667 6.25L10 10L15.8333 6.25L10 2.5Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M4.16667 6.25L4.16667 13.75L10 17.5L15.8333 13.75V6.25" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M10 10V17.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </div>
    <div class="product-stat-content">
      <div class="product-stat-value">10</div>
      <div class="product-stat-label">Total Products</div>
    </div>
  </div>
  <div class="product-stat-card">
    <div class="stat-card__icon stat-card__icon--active">
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M16.6667 5L7.5 14.1667L3.33333 10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </div>
    <div class="product-stat-content">
      <div class="product-stat-value">7</div>
      <div class="product-stat-label">Active</div>
    </div>
  </div>
  <div class="product-stat-card">
    <div class="stat-card__icon stat-card__icon--paused">
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M6.66667 4.16667H13.3333V15.8333H6.66667V4.16667Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </div>
    <div class="product-stat-content">
      <div class="product-stat-value">2</div>
      <div class="product-stat-label">Paused</div>
    </div>
  </div>
  <div class="product-stat-card">
    <div class="stat-card__icon stat-card__icon--out-of-stock">
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M12.5 7.5L7.5 12.5M7.5 7.5L12.5 12.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </div>
    <div class="product-stat-content">
      <div class="product-stat-value">3</div>
      <div class="product-stat-label">Out of Stock</div>
    </div>
  </div>
</div>

<div class="admin-card products-card">
  <div class="products-table-header">
    <div class="products-filters">
      <div class="search-box-enhanced">
        <svg width="18" height="18" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" class="search-icon">
          <path d="M9.16667 15.8333C12.8486 15.8333 15.8333 12.8486 15.8333 9.16667C15.8333 5.48477 12.8486 2.5 9.16667 2.5C5.48477 2.5 2.5 5.48477 2.5 9.16667C2.5 12.8486 5.48477 15.8333 9.16667 15.8333Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M17.5 17.5L13.875 13.875" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <input type="text" class="search-input-enhanced" placeholder="Search products…" />
      </div>
      <select class="filter-select-enhanced">
        <option value="all">All Collections</option>
        <option value="RING">Ring</option>
        <option value="NECKLACE">Necklace</option>
        <option value="BRACELET">Bracelet</option>
        <option value="EARRING">Earring</option>
      </select>
      <div class="products-header-actions">
        <button class="btn btn-icon-secondary" title="Export">
          <svg width="18" height="18" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M10 2.5V12.5M10 12.5L6.66667 9.16667M10 12.5L13.3333 9.16667" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M2.5 15.8333V17.5C2.5 18.1904 3.05964 18.75 3.75 18.75H16.25C16.9404 18.75 17.5 18.1904 17.5 17.5V15.8333" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <button class="btn btn-icon-secondary" title="Refresh">
          <svg width="18" height="18" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M17.5 10C17.5 14.1421 14.1421 17.5 10 17.5C5.85786 17.5 2.5 14.1421 2.5 10C2.5 5.85786 5.85786 2.5 10 2.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M17.5 2.5V7.5H12.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <button class="btn btn-primary" id="process-btn" data-modal-open="newProductModal">
          <svg width="16" height="16" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" style="margin-right: 6px;">
            <path d="M10 4.16667V15.8333M4.16667 10H15.8333" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
          </svg>
          New Product
        </button>
      </div>
    </div>
  </div>

  <div class="admin-table-container">
    <table class="admin-table products-table">
      <thead>
        <tr>
          <th>#</th>
          <th>Product Name</th>
          <th>Product Collection</th>
          <th>Product Size</th>
          <th>Product Weight</th>
          <th class="text-right">Product Price</th>
          <th class="text-center">Product Stock</th>
          <th>Product Status</th>
        </tr>
      </thead>
      <tbody>
        <% products.map(function(value, key) { %>
        <tr>
          <td><%= key + 1 %></td>
          <td>
            <div class="product-name-cell">
              <div class="product-name-main"><%= value.productName.split(' ').slice(0, 2).join(' ') %></div>
              <div class="product-name-sub"><%= value.productName.split(' ').slice(2).join(' ') || 'Jewellery' %></div>
            </div>
          </td>
          <td><span class="collection-badge"><%= value.productCollection %></span></td>
          <td><%= value.productSize || 'N/A' %></td>
          <td><%= value.productWeightGram ? value.productWeightGram + 'g' : 'N/A' %></td>
          <td class="text-right"><span class="price-value">$<%= value.productPrice %></span></td>
          <td class="text-center"><%= value.productLeftCount %></td>
          <td>
            <div class="status-cell-wrapper">
              <span class="status-badge status-<%= value.productStatus === 'PROCESS' ? 'active' : value.productStatus === 'PAUSE' ? 'blocked' : 'deleted' %>" id="badge-<%= value._id %>">
                <%= value.productStatus === 'PROCESS' ? 'Process' : value.productStatus === 'PAUSE' ? 'Pause' : 'Deleted' %>
              </span>
              <select class="new-product-status status-select status-<%= value.productStatus === 'PROCESS' ? 'active' : value.productStatus === 'PAUSE' ? 'blocked' : 'deleted' %>" id="<%= value._id %>" onchange="updateProductStatusBadge('<%= value._id %>', this.value)">
                <option value="PAUSE" <%=value.productStatus==='PAUSE' ? 'selected' : '' %>>PAUSE</option>
                <option value="PROCESS" <%=value.productStatus==='PROCESS' ? 'selected' : '' %>>PROCESS</option>
                <option value="DELETE" <%=value.productStatus==='DELETE' ? 'selected' : '' %>>DELETE</option>
              </select>
            </div>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<!-- Modal Backdrop -->
<div class="fg-modal-backdrop" id="newProductModal" data-modal>
  <div class="fg-modal" role="dialog" aria-labelledby="modal-title" aria-modal="true">
    <div class="fg-modal-header">
      <div class="fg-modal-header-content">
        <h2 class="fg-modal-title" id="modal-title">New Product Detail</h2>
        <p class="fg-modal-subtitle">Add a new jewellery item</p>
      </div>
      <button type="button" class="fg-modal-close" data-modal-close aria-label="Close modal">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M15 5L5 15M5 5L15 15" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </div>
    <div class="fg-modal-body">
      <form onsubmit="return validateForm()" action="/admin/product/create" method="POST" class="product-form-container fg-form" enctype="multipart/form-data">
        <div class="fg-form-content">
          <input name="productStatus" value="PAUSE" class="product-status" hidden />

    <!-- Product Name - Full Width -->
    <div class="fg-form-group fg-form-group-full">
      <label class="fg-form-label required">Product Name</label>
      <input type="text" name="productName" class="fg-form-input product-name" placeholder="Enter product name" required />
    </div>

    <!-- Price and Stock - 2 Column Grid -->
    <div class="fg-form-row">
      <div class="fg-form-group">
        <label class="fg-form-label required">Product Price</label>
        <input type="text" name="productPrice" class="fg-form-input product-price" placeholder="0.00" inputmode="decimal" pattern="[0-9]*\.?[0-9]*" required />
        <div class="fg-form-helper">Enter price in dollars</div>
      </div>
      <div class="fg-form-group">
        <label class="fg-form-label required">Product Stock</label>
        <input type="text" name="productLeftCount" class="fg-form-input product-left-count" placeholder="0" inputmode="numeric" pattern="[0-9]*" required />
        <div class="fg-form-helper">Available quantity</div>
      </div>
    </div>

    <!-- Collection and Product Size - 2 Column Grid -->
    <div class="fg-form-row">
      <div class="fg-form-group">
        <label class="fg-form-label required">Product Collection</label>
        <select class="fg-form-select product-collection" name="productCollection" required>
          <option value="RING">Ring</option>
          <option value="NECKLACE">Necklace</option>
          <option value="BRACELET">Bracelet</option>
          <option value="EARRING">Earring</option>
          <option value="OTHER">Other</option>
        </select>
        <div class="fg-form-helper">Select jewellery type</div>
      </div>
      <div class="fg-form-group">
        <label class="fg-form-label required">Product Size</label>
        <select class="fg-form-select product-size" name="productSize" required>
          <option value="US_4">US 4</option>
          <option value="US_4.5">US 4.5</option>
          <option value="US_5">US 5</option>
          <option value="US_5.5">US 5.5</option>
          <option value="US_6" selected>US 6</option>
          <option value="US_6.5">US 6.5</option>
          <option value="US_7">US 7</option>
          <option value="US_7.5">US 7.5</option>
          <option value="US_8">US 8</option>
          <option value="US_8.5">US 8.5</option>
          <option value="US_9">US 9</option>
          <option value="US_9.5">US 9.5</option>
          <option value="US_10">US 10</option>
        </select>
        <div class="fg-form-helper">Sizes vary by jewellery type (e.g., US ring sizes, bracelet lengths)</div>
      </div>
    </div>

    <!-- Metal Weight - 2 Column Grid (left side, right side empty for future use) -->
    <div class="fg-form-row">
      <div class="fg-form-group">
        <label class="fg-form-label required">Metal Weight (Grams)</label>
        <select class="fg-form-select product-weight-gram" name="productWeightGram" required>
          <option value="1">1g</option>
          <option value="2">2g</option>
          <option value="3">3g</option>
          <option value="4">4g</option>
          <option value="5" selected>5g</option>
          <option value="6">6g</option>
          <option value="8">8g</option>
          <option value="10">10g</option>
          <option value="12">12g</option>
          <option value="15">15g</option>
          <option value="20">20g</option>
          <option value="30">30g</option>
          <option value="50">50g</option>
        </select>
        <div class="fg-form-helper">Metal weight in grams (e.g., 5g)</div>
      </div>
      <div class="fg-form-group"></div>
    </div>

    <!-- Description - Full Width -->
    <div class="fg-form-group fg-form-group-full">
      <label class="fg-form-label">Product Description</label>
      <textarea name="productDesc" class="fg-form-textarea product-desc" placeholder="Enter product description" rows="4"></textarea>
    </div>

    <!-- Product Images - Full Width -->
    <div class="fg-form-group fg-form-group-full">
      <label class="fg-form-label required">Product Images</label>
      <div class="upload-preview" id="image-previews" style="display: grid; grid-template-columns: repeat(5, 1fr); gap: 16px;">
        <div class="upload-img-box">
          <img src="/img/upload.svg" class="1" id="image-section-1" />
          <input type="file" id="file-1" name="productImages" class="image-one" required accept="image/*" onchange="previewFileHandler(this, 1)" style="display: none;" />
        </div>
        <div class="upload-img-box">
          <img src="/img/upload.svg" class="2" id="image-section-2" />
          <input type="file" id="file-2" name="productImages" class="image-two" accept="image/*" onchange="previewFileHandler(this, 2)" style="display: none;" />
        </div>
        <div class="upload-img-box">
          <img src="/img/upload.svg" class="3" id="image-section-3" />
          <input type="file" id="file-3" name="productImages" class="image-three" accept="image/*" onchange="previewFileHandler(this, 3)" style="display: none;" />
        </div>
        <div class="upload-img-box">
          <img src="/img/upload.svg" class="4" id="image-section-4" />
          <input type="file" id="file-4" name="productImages" class="image-four" accept="image/*" onchange="previewFileHandler(this, 4)" style="display: none;" />
        </div>
        <div class="upload-img-box">
          <img src="/img/upload.svg" class="5" id="image-section-5" />
          <input type="file" id="file-5" name="productImages" class="image-five" accept="image/*" onchange="previewFileHandler(this, 5)" style="display: none;" />
        </div>
        <input name="restaurantIid" class="restaurant-id" hidden />
      </div>
    </div>
  </div>

        <div class="fg-form-actions">
          <button type="button" class="btn btn-secondary" id="cancel-btn" data-modal-close>Cancel</button>
          <button type="submit" class="btn btn-primary fg-form-submit" id="create-btn">Create Product</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  // Make images clickable to trigger file input
  document.querySelectorAll('.upload-img-box').forEach((box, index) => {
    box.addEventListener('click', () => {
      const inputId = 'file-' + (index + 1);
      const input = document.getElementById(inputId);
      if (input) input.click();
    });
  });

  // Update product status badge when select changes
  function updateProductStatusBadge(productId, status) {
    const badge = document.getElementById('badge-' + productId);
    const select = document.getElementById(productId);
    
    if (!badge || !select) return;
    
    // Remove all status classes
    badge.className = 'status-badge';
    select.className = 'new-product-status status-select';
    
    // Add appropriate class based on status
    if (status === 'PROCESS') {
      badge.classList.add('status-active');
      select.classList.add('status-active');
      badge.textContent = 'Process';
    } else if (status === 'PAUSE') {
      badge.classList.add('status-blocked');
      select.classList.add('status-blocked');
      badge.textContent = 'Pause';
    } else if (status === 'DELETE') {
      badge.classList.add('status-deleted');
      select.classList.add('status-deleted');
      badge.textContent = 'Deleted';
    }
  }
</script>


<script type="text/javascript" src="/js/products.js"></script>
<%- include('includes/footer') %>

<!DOCTYPE html>
<html lang="en">

<head>
  <title>Facet & Gold - Admin</title>
  <meta charset="UTF-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <link rel="icon" type="image/png" href="/img/favicon.png" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.0.0/dist/css/bootstrap.min.css"
    integrity="sha384-Gn5384xqQ1aoWXA+058RXPxPg6fy4IWvTNh0E263XmFcJlSAwiGgFAW/dAiS6JXm" crossorigin="anonymous" />
  <link rel="stylesheet" type="text/css" href="/css/main.css" />
  <link rel="stylesheet" type="text/css" href="/css/admin.css" />

  <script src="https://code.jquery.com/jquery-3.2.1.slim.min.js"
    integrity="sha384-KJ3o2DKtIkvYIK3UENzmM7KCkRr/rE9/Qpg6aAZGJwFDMVNA/GpGFF93hXpG5KkN"
    crossorigin="anonymous"></script>
  <script src="https://cdn.jsdelivr.net/npm/popper.js@1.12.9/dist/umd/popper.min.js"
    integrity="sha384-ApNbgh9B+Y1QKtv3Rn7W3mgPxhU9K/ScQsAP7hUibX39j7fakFPskvXusvfa0b4Q"
    crossorigin="anonymous"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.0.0/dist/js/bootstrap.min.js"
    integrity="sha384-JZR6Spejh4U02d8jOt6vLEHfe/JQGiRRSQQxSfFWpi1MquVdAyjUar5+76PVCmYl"
    crossorigin="anonymous"></script>
  <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.3.1/jquery.min.js"></script>
  <script src="https://unpkg.com/axios/dist/axios.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
  <script src="/js/main.js"></script>
</head>

<% 
  // Determine current page for active sidebar item
  const currentPath = typeof currentPage !== 'undefined' ? currentPage : '';
  const isAuthPage = currentPath === 'login' || currentPath === 'signup';
  // Show admin layout (sidebar + topbar) only if authenticated AND not on auth pages
  const showAdminLayout = !isAuthPage && member;
%>

<% if (showAdminLayout) { %>
<body>
  <div class="admin-layout">
    <!-- Sidebar -->
    <aside class="admin-sidebar">
      <div class="sidebar-brand">
        <div class="sidebar-brand-main">FACET & GOLD</div>
        <div class="sidebar-brand-subtitle">Fine Jewellery</div>
      </div>
      <nav class="sidebar-nav">
        <div class="sidebar-nav-section">
          <div class="sidebar-nav-section-title">MANAGEMENT</div>
          <a href="/admin/" class="sidebar-nav-item <%= currentPath === '' || currentPath === undefined ? 'active' : '' %>">
            <span class="sidebar-nav-item-icon">
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M7.5 15V10H12.5V15H16.6667V8.33333L10 3.33333L3.33333 8.33333V15H7.5Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
            <span class="sidebar-nav-item-text">Dashboard</span>
          </a>
          <a href="/admin/user/all" class="sidebar-nav-item <%= currentPath === 'users' ? 'active' : '' %> <%= !member ? 'disabled' : '' %>" <%= !member ? 'onclick="return false;" style="opacity: 0.5; cursor: not-allowed;"' : '' %>>
            <span class="sidebar-nav-item-icon">
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M10 10C12.3012 10 14.1667 8.13452 14.1667 5.83333C14.1667 3.53215 12.3012 1.66667 10 1.66667C7.69881 1.66667 5.83333 3.53215 5.83333 5.83333C5.83333 8.13452 7.69881 10 10 10Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M17.1583 18.3333C17.1583 15.1083 13.95 12.5 10 12.5C6.05 12.5 2.84166 15.1083 2.84166 18.3333" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
            <span class="sidebar-nav-item-text">Customers</span>
          </a>
          <a href="/admin/product/all" class="sidebar-nav-item <%= currentPath === 'products' ? 'active' : '' %> <%= !member ? 'disabled' : '' %>" <%= !member ? 'onclick="return false;" style="opacity: 0.5; cursor: not-allowed;"' : '' %>>
            <span class="sidebar-nav-item-icon">
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M10 2.5L4.16667 6.25L10 10L15.8333 6.25L10 2.5Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M4.16667 6.25L4.16667 13.75L10 17.5L15.8333 13.75V6.25" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M10 10V17.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
            <span class="sidebar-nav-item-text">Products</span>
          </a>
          <a href="/admin/analytics" class="sidebar-nav-item <%= currentPath === 'analytics' ? 'active' : '' %> <%= !member ? 'disabled' : '' %>" <%= !member ? 'onclick="return false;" style="opacity: 0.5; cursor: not-allowed;"' : '' %>>
            <span class="sidebar-nav-item-icon">
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M10 2.5V17.5M17.5 10H2.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                <path d="M15.8333 6.66667C16.7538 7.58714 17.3147 8.80714 17.3147 10.0833C17.3147 11.3595 16.7538 12.5795 15.8333 13.5M4.16667 6.66667C3.24619 7.58714 2.68526 8.80714 2.68526 10.0833C2.68526 11.3595 3.24619 12.5795 4.16667 13.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
            <span class="sidebar-nav-item-text">Analytics</span>
          </a>
        </div>
        <div class="sidebar-nav-section">
          <div class="sidebar-nav-section-title">SETTINGS</div>
          <a href="/admin/messages" class="sidebar-nav-item <%= currentPath === 'messages' ? 'active' : '' %> <%= !member ? 'disabled' : '' %>" <%= !member ? 'onclick="return false;" style="opacity: 0.5; cursor: not-allowed;"' : '' %>>
            <span class="sidebar-nav-item-icon">
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M3.33333 5L10 9.58333L16.6667 5M3.33333 5L10 10.4167L16.6667 5M3.33333 5V15L10 10.4167M16.6667 5V15L10 10.4167M10 10.4167V19.1667" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
            <span class="sidebar-nav-item-text">Messages</span>
          </a>
          <a href="/admin/settings" class="sidebar-nav-item <%= currentPath === 'settings' ? 'active' : '' %> <%= !member ? 'disabled' : '' %>" <%= !member ? 'onclick="return false;" style="opacity: 0.5; cursor: not-allowed;"' : '' %>>
            <span class="sidebar-nav-item-icon">
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M10 12.5C11.3807 12.5 12.5 11.3807 12.5 10C12.5 8.61929 11.3807 7.5 10 7.5C8.61929 7.5 7.5 8.61929 7.5 10C7.5 11.3807 8.61929 12.5 10 12.5Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M15.4917 15.4917L14.3167 14.3167M14.3167 5.68333L15.4917 4.50833M4.50833 15.4917L5.68333 14.3167M5.68333 5.68333L4.50833 4.50833M10 3.33333V1.66667M10 18.3333V16.6667M3.33333 10H1.66667M18.3333 10H16.6667" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
            <span class="sidebar-nav-item-text">Settings</span>
          </a>
        </div>
      </nav>
    </aside>

    <!-- Main Content -->
    <main class="admin-main">
      <!-- Top Bar -->
      <header class="admin-topbar">
        <div class="topbar-left">
          <button type="button" class="topbar-back-btn" id="topbar-back-btn" title="Go to Dashboard">
            <svg width="18" height="18" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M12.5 15L7.5 10L12.5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        </div>
        <div class="topbar-right">
          <button type="button" class="topbar-icon-btn" id="topbar-notifications-btn" title="Notifications">
            <svg width="18" height="18" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M15 6.66667C15 5.78261 14.6488 4.93477 14.0237 4.30964C13.3986 3.68452 12.5507 3.33333 11.6667 3.33333C10.7826 3.33333 9.93477 3.68452 9.30964 4.30964C8.68452 4.93477 8.33333 5.78261 8.33333 6.66667C8.33333 12.5 5 14.1667 5 14.1667H18.3333C18.3333 14.1667 15 12.5 15 6.66667Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span class="topbar-notification-dot"></span>
          </button>
          <button type="button" class="topbar-icon-btn" id="topbar-messages-btn" title="Messages">
            <svg width="18" height="18" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M3.33333 5L10 9.58333L16.6667 5M3.33333 5L10 10.4167L16.6667 5M3.33333 5V15L10 10.4167M16.6667 5V15L10 10.4167M10 10.4167V19.1667" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <% if (member) { %>
          <div class="topbar-user-dropdown" id="user-dropdown">
            <div class="topbar-user" onclick="toggleUserMenu()">
              <div class="topbar-user-avatar">
                <% if (member.memberImage) { %>
                  <% 
                    // Ensure image path is absolute and starts with /uploads/
                    let imagePath = member.memberImage;
                    // Remove leading slash if present, then add /uploads/ prefix
                    if (imagePath.startsWith('/')) {
                      imagePath = imagePath.substring(1);
                    }
                    // If path doesn't start with uploads/, add it
                    if (!imagePath.startsWith('uploads/')) {
                      imagePath = 'uploads/' + imagePath;
                    }
                    // Ensure it starts with / for absolute path
                    imagePath = '/' + imagePath;
                  %>
                  <img src="<%= imagePath %>" alt="<%= member.memberNick || 'Admin' %>" />
                <% } else { %>
                  <%= member.memberNick ? member.memberNick.charAt(0).toUpperCase() : 'A' %>
                <% } %>
              </div>
              <div class="topbar-user-info">
                <div class="topbar-user-name"><%= member.memberNick || 'Admin' %></div>
                <div class="topbar-user-role">Jewellery Shop</div>
              </div>
              <svg width="12" height="12" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" style="margin-left: 8px;">
                <path d="M5 7.5L10 12.5L15 7.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <div class="topbar-user-menu" id="user-menu">
              <form action="/admin/logout" method="GET" style="margin: 0;" onsubmit="return confirm('Do you want to logout?');">
                <button type="submit" class="topbar-user-menu-item">
                  Logout
                </button>
              </form>
            </div>
          </div>
          <% } else { %>
          <a href="/admin/login" class="btn btn-secondary btn-sm">Login</a>
          <% } %>
        </div>
      </header>

      <!-- Content Area (will be filled by individual pages) -->
      <div class="admin-content">
<% } else { %>
<body class="auth-page">
<% } %>
